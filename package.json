{
  "name": "claudian",
  "version": "2.5.12",
  "packageManager": "pnpm@10.34.5",
  "description": "Oh My Claudian - provider-backed coding agents embedded in the Obsidian sidebar",
  "main": "main.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "build:css": "node scripts/build-css.mjs",
    "dev": "pnpm run build:css && node esbuild.config.mjs",
    "build": "node scripts/build.mjs production",
    "analyze:bundle": "node scripts/analyze-bundle.mjs",
    "check:lockfile": "pnpm install --frozen-lockfile --ignore-scripts",
    "check:performance": "node scripts/check-startup-performance.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,tests}/**/*.ts\"",
    "lint:fix": "pnpm run lint -- --fix",
    "test": "node scripts/run-tests.js",
    "test:unit": "node scripts/run-jest.js",
    "test:architecture": "node --test scripts/check-architecture-boundaries.test.mjs",
    "test:watch": "node scripts/run-jest.js --watch",
    "test:coverage": "node scripts/run-jest.js --coverage",
    "preversion": "pnpm install --frozen-lockfile",
    "version": "node scripts/sync-version.js && git add manifest.json"
  },
  "keywords": [
    "claude-code",
    "obsidian",
    "obsidian-plugin",
    "productivity",
    "ide"
  ],
  "author": "Lee",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@types/cross-spawn": "6.0.6",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^25.5.2",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.2.0",
    "eslint-plugin-jest": "^29.15.1",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "jest": "^30.3.0",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.3.0",
    "obsidian": "latest",
    "ts-jest": "^29.4.9",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/sdk": "~1.31.0",
    "cross-spawn": "7.0.6",
    "preact": "^10.29.8",
    "smol-toml": "^1.9.0",
    "tslib": "^2.8.1",
    "zod": "4.4.3"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@hono/node-server": "2.0.11",
    "brace-expansion@^1.0.0": "1.1.21",
    "brace-expansion@^2.0.0": "2.1.7",
    "brace-expansion@^5.0.0": "5.0.12",
    "body-parser": "2.3.0",
    "fast-uri": "3.1.8",
    "hono": "4.13.7",
    "ip-address": "10.7.2",
    "js-yaml": "4.3.2",
    "moment": "2.31.0",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@^1.0.0": "1.1.21",
      "brace-expansion@^2.0.0": "2.1.7",
      "brace-expansion@^5.0.0": "5.0.12",
      "fast-uri": "3.1.8",
      "hono": "4.13.7",
      "ip-address": "10.7.2",
      "js-yaml": "4.3.2",
      "moment": "2.31.0",
      "proxy-addr": "2.0.8",
      "qs": "6.16.0"
    }
  }
}
